# ============================================
# QuizUpWebSocket - Variables de entorno de ejemplo
# Copia este archivo a .env y completa los valores.
# Las variables marcadas (opcional) pueden omitirse: se usa el default indicado.
# ============================================

# Conexión a MongoDB (requerida; debe coincidir con la del frontend)
MONGODB_URI=mongodb://localhost:27017/quizup

# URI para el runner manual de tests con Mongo (opcional).
# SOLO base de test: nunca apuntar a la base de desarrollo.
# Si se omite, `node tools/test-with-mongo.mjs` la deriva de MONGODB_URI
# reemplazando el nombre de la base por --db (default: quizup_test).
# MONGODB_URI_TEST=mongodb://localhost:27017/quizup_test

# Puerto del servidor WebSocket (opcional; default 4000)
PORT=4000

# Minutos que una partida puede quedar pendiente sin iniciarse
# antes de cerrarse automáticamente (opcional; default 60)
GAME_EXPIRY_MINUTES=60

# Origen permitido para CORS (opcional; default *)
CORS_ORIGIN=*

# Nivel de log (opcional; default info): debug | info | warn | error
LOG_LEVEL=info